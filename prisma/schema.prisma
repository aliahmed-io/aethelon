generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id                     String                @id @unique
  email                  String
  firstName              String
  lastName               String
  socialTitle            String?
  birthdate              DateTime?
  profileImage           String
  createdAt              DateTime              @default(now())
  chatSessions           ChatSession[]
  orders                 Order[]
  reviews                Review[]
  tryOnSessions          TryOnSession[]
  newsletterSubscription NewsletterSubscriber?
  auditLogs              AuditLog[]
  returnRequests         ReturnRequest[]
  addresses              Address[]
  wishlistItems          WishlistItem[]
  abandonedCarts         AbandonedCart[]
  role                   UserRole              @default(USER)

  // AI Governance
  aiGenerationsCount Int      @default(0)
  lastGenerationDate DateTime @default(now())
}

enum UserRole {
  ADMIN
  USER
}

model SearchAnalytics {
  id        String   @id @default(uuid())
  query     String
  userId    String?
  results   Int
  clicked   String?
  converted Boolean? @default(false)
  createdAt DateTime @default(now())
}

model Attribute {
  id        String   @id @default(uuid())
  name      String   @unique
  values    String[]
  createdAt DateTime @default(now())
}

model WishlistItem {
  id                String   @id @default(uuid())
  userId            String
  productId         String
  addedPrice        Int      @default(0)
  lastNotifiedPrice Int?
  createdAt         DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model Product {
  id                 String        @id @default(uuid())
  name               String
  description        String
  status             ProductStatus
  price              Int
  images             String[]
  // Removed categoryId
  isFeatured         Boolean       @default(false)
  isVaultExclusive   Boolean       @default(false)
  createdAt          DateTime      @default(now())
  color              String?       @default("")
  style              String?       @default("")
  height             String?       @default("")
  pattern            String?       @default("")
  tags               String[]      @default([])
  features           String[]      @default([])
  sizes              String[]      @default([])
  brand              String?       @default("Generic")
  modelUrl           String?
  usdzUrl            String? // For iOS AR Quick Look
  imageDescription   String?
  discountPercentage Int           @default(0)
  averageRating      Float         @default(0)
  reviewCount        Int           @default(0)
  meshyProgress      Int?          @default(0)
  meshyStatus        String?       @default("PENDING")
  meshyTaskId        String?

  // Inventory Fields
  stockQuantity     Int   @default(0)
  costPrice         Int   @default(0) // In cents
  reservedStock     Int   @default(0)
  weight            Float @default(1.0)
  lowStockThreshold Int   @default(5)

  // Backorder Fields
  allowBackorder Boolean @default(false)
  backorderLimit Int     @default(0)

  // Vector Search
  embedding Unsupported("vector(768)")?

  // Collection Logic
  categories   Category[]
  mainCategory MainCategory @default(MEN)
  staticScore  Float        @default(0) // Precomputed: Pop + Rat + Rec

  reviews               Review[]
  tryOnSessions         TryOnSession[]
  orderItems            OrderItem[]
  wishlistItems         WishlistItem[]
  campaignItems         CampaignProduct[]
  inventoryTransactions InventoryTransaction[]

  // Performance indexes for common queries
  @@index([status])
  @@index([mainCategory])
  @@index([createdAt])
  @@index([reviewCount])
  @@index([isFeatured])
  @@index([staticScore])
}

model InventoryTransaction {
  id          String                   @id @default(uuid())
  productId   String
  type        InventoryTransactionType
  quantity    Int
  unitCost    Int                      @default(0) // Cost at time of transaction
  unitPrice   Int                      @default(0) // Selling price at time of transaction (if applicable)
  referenceId String? // Order ID, Return ID, etc.
  reason      String?
  createdAt   DateTime                 @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
}

enum InventoryTransactionType {
  SALE
  RESERVE
  RELEASE
  RESTOCK
  RETURN
  MANUAL_ADJUSTMENT
}

enum RankingMode {
  DEFAULT
  SEMANTIC
  TRENDING
}

model Category {
  id          String  @id @default(uuid())
  name        String
  slug        String
  description String?
  image       String?

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  products Product[]

  rankingMode RankingMode @default(DEFAULT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, parentId])
  @@index([parentId])
}

model Banner {
  id          String    @id @default(uuid())
  title       String
  imageString String
  link        String?   @default("/")
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([campaignId])
}

model Campaign {
  id              String            @id @default(uuid())
  title           String
  slug            String            @unique
  description     String?
  status          CampaignStatus    @default(DRAFT)
  startDate       DateTime?
  endDate         DateTime?
  heroImage       String?
  mobileHeroImage String?
  theme           Json? // { backgroundColor, accentColor, fontColor }
  metadata        Json? // { seoTitle, seoDescription, ogImage }
  products        CampaignProduct[]
  banners         Banner[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
  @@index([slug])
}

model CampaignProduct {
  campaignId    String
  productId     String
  order         Int      @default(0)
  badge         String?
  highlightText String?
  createdAt     DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([campaignId, productId])
  @@index([campaignId])
  @@index([productId])
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Order {
  id                String            @id @default(uuid())
  status            OrderStatus       @default(CREATED)
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)

  amount         Int
  userId         String?
  createdAt      DateTime    @default(now())
  discountId     String?
  discount       Discount?   @relation(fields: [discountId], references: [id])
  User           User?       @relation(fields: [userId], references: [id])
  payment        Payment?
  orderItems     OrderItem[]
  shippingLabel  String?
  trackingNumber String?

  // Tax Fields
  taxAmount Int?
  taxRate   Float?
  taxName   String?

  // Shipping Address Fields
  shippingName       String?
  shippingStreet1    String?
  shippingStreet2    String?
  shippingCity       String?
  shippingState      String?
  shippingPostalCode String?
  shippingCountry    String?
  shippingCost       Int     @default(0)

  returnRequest ReturnRequest?
  shipments     Shipment[]

  @@index([userId])
  @@index([status])
}

model Shipment {
  id             String   @id @default(uuid())
  orderId        String
  carrier        String?
  service        String?
  trackingNumber String?
  labelUrl       String?
  status         String   @default("PRE_TRANSIT")
  createdAt      DateTime @default(now())

  order Order          @relation(fields: [orderId], references: [id])
  items ShipmentItem[]

  @@index([orderId])
}

model ShipmentItem {
  id          String @id @default(uuid())
  shipmentId  String
  orderItemId String
  quantity    Int

  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([shipmentId])
}

model OrderItem {
  id            String         @id @default(uuid())
  orderId       String
  productId     String?
  quantity      Int
  price         Int
  name          String
  size          String?
  image         String?
  createdAt     DateTime       @default(now())
  order         Order          @relation(fields: [orderId], references: [id])
  product       Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  shipmentItems ShipmentItem[]

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                    String        @id @default(uuid())
  orderId               String        @unique
  amount                Int
  currency              String
  status                PaymentStatus
  paymentMethod         String?
  stripePaymentIntentId String?
  createdAt             DateTime      @default(now())
  order                 Order         @relation(fields: [orderId], references: [id])
}

model Discount {
  id        String    @id @default(uuid())
  code      String    @unique
  amount    Int
  type      String // PERCENTAGE or FIXED
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  orders    Order[]
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  userId    String
  productId String
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model TryOnSession {
  id        String   @id @default(uuid())
  userId    String
  productId String
  imageUrl  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  userId    String?  @unique
  status    String   @default("subscribed") // subscribed, unsubscribed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([targetType, targetId])
}

model ReturnRequest {
  id             String       @id @default(uuid())
  orderId        String       @unique
  userId         String
  reason         String
  status         ReturnStatus @default(PENDING)
  refundAmount   Int?
  adminNotes     String?
  returnLabelUrl String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([userId])
}

model Address {
  id         String  @id @default(uuid())
  userId     String
  name       String
  street1    String
  street2    String?
  city       String
  state      String
  postalCode String
  country    String  @default("US")
  phone      String?
  isDefault  Boolean @default(false)
  user       User    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ChatSession {
  id        String    @id @default(uuid())
  userId    String?
  messages  Message[]
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id])
}

model Message {
  id        String      @id @default(uuid())
  sessionId String
  role      MessageRole
  content   String
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id])
}

model Alert {
  id        String   @id @default(uuid())
  type      String
  severity  String
  message   String
  metadata  Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model WebhookEvent {
  id          String   @id @default(uuid())
  provider    String // "stripe", "shippo"
  eventId     String   @unique // The external ID (req.headers["stripe-signature"] or body.id)
  eventType   String // "checkout.session.completed", "track_updated"
  payload     Json
  status      String // "processed", "failed"
  error       String?
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

model AICache {
  key       String   @id
  content   Json
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AiInteractionLog {
  id             String   @id @default(uuid())
  route          String
  input          String
  mode           String?
  ip             String?
  responseTimeMs Int
  success        Boolean
  errorMessage   String?
  createdAt      DateTime @default(now())
}

model DailyStat {
  id            String   @id @default(uuid())
  date          DateTime @unique @default(now())
  totalRevenue  Int      @default(0)
  totalOrders   Int      @default(0)
  totalVisitors Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum ProductStatus {
  draft
  published
  archived
}

enum OrderStatus {
  CREATED
  PAYMENT_PENDING
  PAID
  ALLOCATED
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  RETURNED
  PARTIALLY_RETURNED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum MessageRole {
  user
  assistant
  system
}

enum MainCategory {
  MEN
  WOMEN
  KIDS
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("PENDING") // PENDING, COMPLETED, ARCHIVED
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoreConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AbandonedCart {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cartData           Json
  email              String
  totalCents         Int
  itemCount          Int       @default(0)
  emailsSent         Int       @default(0)
  lastEmailAt        DateTime?
  recoveredAt        DateTime?
  manualIntervention Boolean   @default(false)
  recoveryToken      String?   @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@index([emailsSent, recoveredAt, lastEmailAt])
}

model TaxRule {
  id        String   @id @default(uuid())
  country   String
  region    String?
  name      String
  rate      Float
  inclusive Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([country, region])
  @@index([country])
}

model BlogPost {
  id              String    @id @default(uuid())
  title           String
  slug            String    @unique
  content         String    @db.Text
  excerpt         String?   @db.Text
  category        String    @default("General")
  readTime        String?
  metaDescription String?   @db.Text
  published       Boolean   @default(false)
  image           String?
  author          String    @default("Aethelon Team")
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([slug])
  @@index([publishedAt])
}
