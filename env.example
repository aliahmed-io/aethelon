# ==========================================
# AETHELON SERVER: ENVIRONMENT VARIABLES
# ==========================================
# Note: Copy this file to '.env' or '.env.local' 
# and fill in the values before running the app.

# ------------------------------------------
# 1. DATABASE & ORM (Neon / Vercel Postgres)
# ------------------------------------------
# The connection string for the Prisma schema.
# If using Prisma Accelerate, ensure the pooling protocol ?api_key= is attached.
DATABASE_URL="postgres://user:password@host/database"

# ------------------------------------------
# 2. AUTHENTICATION (Kinde Auth)
# ------------------------------------------
# Required for user session management and Next.js App Router protection.
KINDE_CLIENT_ID="[your_kinde_client_id]"
KINDE_CLIENT_SECRET="[your_kinde_client_secret]"
KINDE_ISSUER_URL="https://[your_kinde_subdomain].kinde.com"

# The canonical URL where the application runs (e.g. http://localhost:3000 locally, or deployed domain).
KINDE_SITE_URL="http://localhost:3000"
KINDE_POST_LOGOUT_REDIRECT_URL="http://localhost:3000"
KINDE_POST_LOGIN_REDIRECT_URL="http://localhost:3000/dashboard"

# ------------------------------------------
# 3. PAYMENTS & COMMERCE (Stripe)
# ------------------------------------------
# Used for server-side charge processing and checkout sessions.
STRIPE_API_KEY="sk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
# Webhook signing secret to verify Stripe events safely.
STRIPE_WEBHOOK_SECRET="whsec_..."
# Public key for the client-side Stripe checkout overlay.
NEXT_PUBLIC_STRIPE_KEY="pk_test_..."

# ------------------------------------------
# 4. EDGE CACHING & MEMORY (Upstash Redis)
# ------------------------------------------
# Used for AI query caching and cart session state.
UPSTASH_REDIS_REST_URL="https://[your_upstash_domain].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[your_upstash_token]"

# ------------------------------------------
# 5. ARTIFICIAL INTELLIGENCE (Google Gemini)
# ------------------------------------------
# Powers the Advanced Semantic Search, Vision context, and 3D Assistant workflows.
GEMINI_API_KEY="[your_google_ai_studio_api_key]"

# ------------------------------------------
# 6. FILE PIPELINE & CDN (UploadThing)
# ------------------------------------------
# Powers product image uploads, CMS banners, and 3D (.glb) file ingestion.
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID="[your_uploadthing_app_id]"

# ------------------------------------------
# 7. TRANSACTIONAL EMAIL (Resend)
# ------------------------------------------
# Dispatches order confirmations and cart recovery emails.
RESEND_API_KEY="re_..."
RESEND_FROM="onboarding@resend.dev" # Replace with a verified domain (e.g., no-reply@aethelon.com)

# ------------------------------------------
# 8. AUTHORIZATION & SECRETS
# ------------------------------------------
# Comma separated list of email addresses that have Admin Dashboard access.
ADMIN_EMAILS="admin1@example.com,admin2@example.com"

# Canonical base URL for absolute linking logic (e.g., SEO metatags, Webhook verification callbacks).
NEXT_PUBLIC_URL="http://localhost:3000"
